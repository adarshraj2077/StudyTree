# StudyTree Backend Environment Configuration

# Server Port
PORT=3001

# Google Gemini API Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash

# MongoDB Connection String (Optional - falls back automatically to resilient local JSON persistence)
MONGODB_URI=mongodb://127.0.0.1:27017/studytree
